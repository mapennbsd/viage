#!/bin/sh
# viage - keep secrets in age-encrypted files, edited vipw style.
#
# The vault is a directory of files encrypted to one age identity, and
# the identity is itself encrypted with a passphrase. Each command asks
# for the passphrase once and handles plaintext only in a RAM-backed
# directory. Plaintext never touches persistent storage.
#
